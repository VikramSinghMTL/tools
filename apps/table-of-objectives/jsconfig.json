{
	"compilerOptions": {
		"checkJs": true,
		"noImplicitAny": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"]
	},
	"include": [
		"src/**/*.js",
		"src/**/*.d.ts",
		"scripts/**/*.mjs",
		"vite.config.js"
	],
	"exclude": ["node_modules", "dist"]
}
